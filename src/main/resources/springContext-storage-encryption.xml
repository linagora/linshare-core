<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation=" http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!--
		Not profile-gated: this always loads regardless of which storage
		profile (jcloud, jcloud-only, gridfs, migration-gridfs-to-jcloud) is
		active, and wraps that profile's rawFileDataStore. Whether it actually
		encrypts is controlled purely by the write-enabled/read-enabled
		properties below; with both false (the default) the delegate is
		returned unchanged (docs/ARCH.md, docs/CLAUDE.md).
	-->
	<bean id="encryptedFileDataStoreFactory"
		class="org.linagora.linshare.core.dao.utils.EncryptedFileDataStoreFactory">
		<property name="delegate" ref="rawFileDataStore" />
		<property name="writeEnabled" value="${linshare.documents.encryption.write-enabled}" />
		<property name="readEnabled" value="${linshare.documents.encryption.read-enabled}" />
		<property name="allowLegacyRead" value="${linshare.documents.encryption.allow-legacy-read}" />
		<property name="chunkSize" value="${linshare.documents.encryption.chunk-size}" />
		<property name="keyProvider" value="${linshare.documents.encryption.key-provider}" />
		<property name="localMasterKeyFile" value="${linshare.documents.encryption.local.master-key-file}" />
		<property name="keyId" value="${linshare.documents.encryption.key-id}" />
		<property name="vaultAddress" value="${linshare.documents.encryption.vault.address}" />
		<property name="vaultTokenFile" value="${linshare.documents.encryption.vault.token-file}" />
		<property name="vaultTransitKeyName" value="${linshare.documents.encryption.vault.transit-key-name}" />
	</bean>

	<bean
		id="fileDataStore"
		factory-bean="encryptedFileDataStoreFactory"
		factory-method="getDefault"
		/>

</beans>
